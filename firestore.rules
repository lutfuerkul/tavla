rules_version = '2';

// Nobody writes. Every change to a room or a match goes through a function,
// which is the only place the rules of tavla are enforced and the only place
// the dice are thrown — a client that could write here could deal itself a
// double six and move its checkers anywhere it liked.
//
// Reading is narrow too: a match is readable by the two people playing it, and
// a room by anyone who knows its code, which is the whole point of a code.
service cloud.firestore {
  match /databases/{database}/documents {

    // The two people playing in it, and nobody else. A code is a thing you say
    // out loud to one person; it was readable by anybody signed in, and a rule
    // that allows a document to be read allows the collection to be listed —
    // so every open room and its code could simply be asked for, and a stranger
    // could take the seat the code was said for. The guest never reads the room
    // anyway: they hand the code to a function, which is where knowing it is
    // checked. This is only the host, watching their own room for somebody to
    // arrive, and the guest afterwards.
    // A room that is not there is readable by anyone signed in, and has nothing
    // in it to read. This is not a loosening: without it, a host watching their
    // own room is cut off the moment the room goes — see the matches rule below,
    // where the same omission cost rather more.
    match /rooms/{code} {
      allow read: if request.auth != null
        && (resource == null
            || request.auth.uid == resource.data.host
            || request.auth.uid == resource.data.guest);
      allow write: if false;
    }

    // Your own place in the queue, so the board can watch for the match that
    // gets written onto it. Only yours: the queue is not a list of who is
    // looking for a game, it is a way of being found.
    match /sira/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // The two people playing it — and, once it is gone, anybody, because there
    // is nothing left to read. That last part is not a nicety. A match is
    // deleted the moment its last player gets up, and a listener on a deleted
    // document is asked this question with `resource` set to null: without the
    // first line the rule threw on the null instead of answering, and Firestore
    // tears a listener down on an error rather than reporting the deletion. So
    // the one board still sitting there never heard that the table had gone.
    // It kept the last position on the screen, looking perfectly playable,
    // deaf to everything — no result, no news, no way of knowing.
    match /matches/{id} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.players.values());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
